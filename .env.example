# Qloo hackathon key (https://hackathon.api.qloo.com, header X-Api-Key)
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# NVIDIA Nemotron on Nebius Token Factory: the agent, the control group and the pitches
NEBIUS_API_KEY=

# Room capacities from the web
TAVILY_API_KEY=

# Where tours, the daily counters and the capacity cache live. Google Cloud Storage: a private bucket, plus
# either a workload identity provider that trusts Vercel's OIDC issuer (keyless; the bucket role is granted to
# principal://iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/subject/owner:<team>:project:<project>:environment:production)
# or a service-account JSON key, base64-encoded. Or Vercel Blob. Leave all empty to keep tours in .data/.
GCS_BUCKET=
GCS_WIF_AUDIENCE=//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
GCS_SA_KEY=
BLOB_READ_WRITE_TOKEN=
# Daily allowances for the public demo (model runs, Qloo requests, tours routed through the MCP endpoint)
# QLOO_DAILY_CAP=2500
# MCP_DAILY_CAP=12

DAILY_MODEL_CAP=200
# ADMIN_TOKEN=
