# Qloo hackathon key (https://hackathon.api.qloo.com, header X-Api-Key)
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# NVIDIA Nemotron on Nebius Token Factory: the agent, the control group and the pitches
NEBIUS_API_KEY=

# Room capacities from the web
TAVILY_API_KEY=

# Where tours, the daily counters and the capacity cache live. Google Cloud Storage: a bucket and a service
# account with roles/storage.objectAdmin on it, its JSON key base64-encoded. Or Vercel Blob. Leave both empty to
# keep tours in .data/ (counters then live in memory).
GCS_BUCKET=
GCS_SA_KEY=
BLOB_READ_WRITE_TOKEN=
# Daily allowances for the public demo (model runs, Qloo requests, tours routed through the MCP endpoint)
# QLOO_DAILY_CAP=2500
# MCP_DAILY_CAP=12

DAILY_MODEL_CAP=200
# ADMIN_TOKEN=
